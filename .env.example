# Configurações do Banco de Dados (Supabase)
VITE_SUPABASE_URL=https://sua-url.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# Integração Bancária (Efí Bank)
# Nota: O arquivo de certificado (.pem) deve estar no caminho indicado em EFI_CERT_PATH
EFI_CLIENT_ID=seu_client_id
EFI_CLIENT_SECRET=seu_client_secret
EFI_CERT_PASSWORD=sua_senha_do_certificado
EFI_CERT_PATH=/caminho/para/seu/certificado.pem
EFI_IS_SANDBOX=false

# E-mail (Resend)
RESEND_API_KEY=re_sua_chave_aqui

# WhatsApp (Evolution API)
EVOLUTION_API_URL=https://sua-instancia.com
EVOLUTION_API_KEY=sua_api_key
EVOLUTION_API_INSTANCE=NomeDaInstancia

# Segurança (Google reCAPTCHA)
RECAPTCHA_SITE_KEY=sua_site_key
RECAPTCHA_SECRET_KEY=sua_secret_key

# CRM Interno (Opcional)
EXTERNAL_CRM_API_KEY=sua_chave_de_acesso_crm
